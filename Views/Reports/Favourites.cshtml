@model List<wekdi.Models.Product>

@{
    ViewData["Title"] = "Favourites";
}

<h2>Top 3 Favourite Products</h2>

<div class="row g-4">
    @foreach (var p in Model)
    {
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <img src="@Url.Content("~/images/products/" + (p.ImagePath ?? "default.png"))" class="card-img-top" alt="@p.Name">

                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@p.Name</h5>
                    <p class="card-text">@p.Description</p>
                    <p><strong>RM @p.Price</strong></p>
                </div>
            </div>
        </div>
    }
</div>
