@model List<wekdi.Models.OrderHistoryViewModel>

@{
    ViewData["Title"] = "Order History";
}

<!-- ===== Embedded McDonald's-style CSS ===== -->
<style>
    body {
        background-color: #fff8f0;
        font-family: "Segoe UI", Arial, sans-serif;
    }

    h2 {
        color: #d32300; /* McDonald's red */
        font-weight: 700;
        margin-bottom: 1rem;
    }

    /* Return button */
    .btn-secondary {
        background-color: #d32300;
        border: none;
        color: #fff;
        font-weight: 600;
        padding: 0.5rem 1.2rem;
        border-radius: 30px;
        transition: background-color .2s;
    }

        .btn-secondary:hover {
            background-color: #b71c00;
        }

    /* Filter panel */
    #filterForm {
        background: #fff;
        padding: 1rem 1.5rem;
        border-radius: 12px;
        border: 2px solid #ffd100; /* McDonald's yellow border */
        box-shadow: 0 2px 6px rgba(0,0,0,0.1);
    }

        #filterForm label {
            font-weight: 600;
            color: #333;
        }

    /* Table styling */
    table.table {
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 3px 10px rgba(0,0,0,0.1);
    }

    table thead {
        background-color: #ffd100; /* golden yellow header */
        color: #000;
        font-weight: 700;
        text-transform: uppercase;
    }

    table tbody tr:hover {
        background-color: #fff2cc; /* light yellow highlight */
    }

    /* Action button */
    .btn-info {
        background-color: #d32300;
        border: none;
        color: #fff;
        font-weight: 600;
        border-radius: 20px;
        padding: 0.35rem 0.9rem;
        transition: background-color .2s;
    }

        .btn-info:hover {
            background-color: #b71c00;
        }

    /* Item thumbnails */
    .img-thumbnail {
        border: 2px solid #ffd100;
        padding: 2px;
        background: #fff;
    }
</style>

<a asp-action="MemberProfile" asp-controller="Account" class="btn btn-secondary">⟵ Return</a>
<br />
<br />

<h2>Order History</h2>

<form id="filterForm" method="get" class="mb-4 row g-3 align-items-end">
    <div class="col-auto">
        <label>Start Date</label>
        <input type="date" name="startDate" class="form-control" value="@ViewBag.StartDate" />
    </div>
    <div class="col-auto">
        <label>End Date</label>
        <input type="date" name="endDate" class="form-control" value="@ViewBag.EndDate" />
    </div>
    <div class="col-auto d-flex gap-2">
        <button type="submit" class="btn btn-primary">Filter</button>
        <a asp-action="OrderHistory" asp-controller="MemberOrders"
           class="btn btn-outline-secondary">Reset</a>
    </div>
</form>

@if (!Model.Any())
{
    <p>No orders found.</p>
}
else
{
    <table class="table table-striped table-bordered align-middle">
        <thead>
            <tr>
                <th>Order ID</th>
                <th>Date</th>
                <th>Status</th>
                <th>Items</th>
                <th>Total</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td>@order.OrderId</td>
                    <td>@order.OrderDate.ToString("dd MMM yyyy")</td>
                    <td>@order.Status</td>
                    <td>
                        <div class="d-flex flex-wrap">
                            @foreach (var item in order.Items)
                            {
                                <div class="text-center me-2 mb-2">
                                    <img src="@Url.Content($"/images/products/{item.ProductImage ?? "default.png"}")"
                                         style="width:60px;height:60px;object-fit:cover;border-radius:8px;"
                                         class="img-thumbnail" />
                                    <div style="font-size:0.8rem;">@item.ProductName</div>
                                    <div style="font-size:0.8rem;">x@item.Quantity</div>
                                </div>
                            }
                        </div>
                    </td>
                    <td>@order.TotalAmount.ToString("C")</td>
                    <td>
                        <a asp-controller="MemberOrders" asp-action="Details"
                           asp-route-id="@order.OrderId" class="btn btn-sm btn-info">
                            View Details
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@section Scripts {
    <script>
        // prevent invalid date range
        document.getElementById('filterForm').addEventListener('submit', function (e) {
            const start = new Date(this.startDate.value);
            const end   = new Date(this.endDate.value);
            if (this.startDate.value && this.endDate.value && start > end) {
                e.preventDefault();
                alert("Start Date cannot be later than End Date.");
            }
        });
    </script>
}
