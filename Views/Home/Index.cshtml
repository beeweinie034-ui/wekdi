@model List<wekdi.Models.Product>

@{
    ViewData["Title"] = "Menu";
}

<style>
    /* --------- CATEGORY & SEARCH --------- */
    #menu {
        text-align: center;
        font-size: 2.5rem;
        font-weight: 700;
        margin: 3rem 0 2rem;
        color: #d32f2f; /* McD red */
    }

    form[method="get"] .form-control {
        border-radius: 30px;
        padding: 0.75rem 1.5rem;
    }

    form[method="get"] .btn-outline-primary {
        border-radius: 30px;
        font-weight: 600;
        border-color: #d32f2f;
        color: #d32f2f;
    }

        form[method="get"] .btn-outline-primary:hover {
            background-color: #d32f2f;
            color: #fff;
        }

    .btn-outline-danger {
        border-radius: 30px;
        margin: 0.25rem;
        border-color: #d32f2f;
        color: #d32f2f;
        font-weight: 600;
        transition: all .2s;
    }

        .btn-outline-danger:hover,
        .btn-outline-danger.active {
            background-color: #d32f2f;
            color: #fff;
        }

    /* --------- PRODUCT GRID --------- */
    #productGrid .card {
        border: none;
        border-radius: 1rem;
        transition: transform .2s ease, box-shadow .2s ease;
    }

        #productGrid .card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.15);
        }
    /* keep natural image size—no fixed height or cropping */
    #productGrid .card-img-top {
        border-top-left-radius: 1rem;
        border-top-right-radius: 1rem;
        object-fit: contain;
        width: 100%;
        height: auto;
    }

    #productGrid .card-title {
        font-size: 1.25rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
        color: #d32f2f;
    }

    #productGrid .card-text {
        flex-grow: 1;
        color: #555;
        font-size: 0.95rem;
    }

    #productGrid strong {
        font-size: 1.1rem;
        color: #000;
    }

    /* --------- CART BUTTON --------- */
    .add-to-cart-btn {
        background-color: #d32f2f;
        border: none;
        font-weight: 600;
        padding: 0.6rem 1rem;
        border-radius: 30px;
        transition: background 0.3s;
    }

        .add-to-cart-btn:hover {
            background-color: #b71c1c;
        }
</style>

<!-- Hero section left UNCHANGED -->
<div class="hero-section">
    <div class="hero-content">
        <h1 class="display-4 fw-bold">Welcome to Mekdi 🍔🍟</h1>
        <p class="lead">Delicious meals, fresh ingredients, and your favorites always ready.</p>
        <a href="#menu" class="btn btn-warning btn-lg mt-3">See Our Menu</a>
    </div>
</div>

<h2 id="menu" class="mb-4">Our Menu</h2>

<!-- Search bar -->
<form asp-action="Index" method="get" class="mb-4 d-flex justify-content-center gap-2">
    <input type="text"
           name="search"
           class="form-control w-50"
           placeholder="Search products..."
           value="@ViewBag.Search" />
    @if (ViewBag.SelectedCategory != null)
    {
        <input type="hidden" name="categoryId" value="@ViewBag.SelectedCategory" />
    }
    <button type="submit" class="btn btn-outline-primary">Search</button>
</form>

<div class="mb-4 text-center">
    <a class="btn btn-outline-danger @(ViewBag.SelectedCategory == null ? "active" : "")"
       href="@Url.Action("Index", new { categoryId = (int?)null, search = ViewBag.Search })#menu">All</a>

    @foreach (var category in ViewBag.Categories)
    {
        <a class="btn btn-outline-danger @(ViewBag.SelectedCategory == category.CategoryId ? "active" : "")"
           href="@Url.Action("Index", new { categoryId = category.CategoryId, search = ViewBag.Search })#menu">
            @category.Name
        </a>
    }
</div>

<!-- Product grid -->
<div id="productGrid" class="row g-4">
    @foreach (var p in Model)
    {
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                @if (!string.IsNullOrEmpty(p.ImagePath))
                {
                    <img src="@Url.Content("~/images/products/" + p.ImagePath)" class="card-img-top" alt="@p.Name">
                }
                else
                {
                    <img src="@Url.Content("~/images/products/default.png")" class="card-img-top" alt="No Image">
                }

                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@p.Name</h5>
                    <p class="card-text">@p.Description</p>
                    <p><strong>RM @p.Price</strong></p>

                    <form class="add-to-cart-form" data-product="@p.ProductId">
                        <select name="Quantity" class="form-select mb-2">
                            @for (int qty = 1; qty <= 10; qty++)
                            {
                                <option value="@qty">@qty</option>
                            }
                        </select>
                        <button type="button" class="btn btn-danger w-100 add-to-cart-btn">🛒 Add to Cart</button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        // unchanged JS for Add to Cart + live search
        document.querySelectorAll(".add-to-cart-btn").forEach(btn => {
            btn.addEventListener("click", function () {
                const form = this.closest(".add-to-cart-form");
                const productId = form.dataset.product;
                const qty = form.querySelector("select[name='Quantity']").value;

                fetch("/ShoppingCart/AddAjax", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        "RequestVerificationToken":
                          document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify({ productId: productId, quantity: qty })
                })
                .then(r => r.json())
                .then(data => {
                    if (data.success) {
                        document.getElementById("cartNotice").textContent =
                            `Cart: ${data.totalItems} items`;

                        window.showGlobalAlert("Item successfully added to cart!", "success");

                        if (data.limitReached) {
                            window.showGlobalAlert("Cart is full, maximum 10 items only!", "danger");
                        }
                    } else {
                        window.showGlobalAlert(data.message, "danger");
                    }
                });
            });
        });

        const searchInput = document.querySelector('input[name="search"]');
        const grid        = document.getElementById('productGrid');
        const originalHtml = grid.innerHTML;
        const categoryId  = '@(ViewBag.SelectedCategory ?? "")';
        let timer;

        searchInput.addEventListener('input', () => {
            clearTimeout(timer);
            timer = setTimeout(() => {
                const term = searchInput.value.trim();

                if (!term) {
                    grid.innerHTML = originalHtml;
                    return;
                }

                fetch(`/Home/Search?term=${encodeURIComponent(term)}&categoryId=${categoryId}`)
                    .then(r => r.json())
                    .then(data => {
                        grid.innerHTML = "";

                        if (!data.products.length) {
                            grid.innerHTML = '<p class="text-muted text-center w-100">No products found.</p>';
                            return;
                        }

                        data.products.forEach(p => {
                            grid.insertAdjacentHTML('beforeend', `
                                <div class="col-md-4">
                                    <div class="card shadow-sm h-100">
                                        <img src="${p.imagePath}" class="card-img-top" alt="${p.name}">
                                        <div class="card-body d-flex flex-column">
                                            <h5 class="card-title">${p.name}</h5>
                                            <p class="card-text">${p.description ?? ""}</p>
                                            <p><strong>RM ${p.price}</strong></p>
                                        </div>
                                    </div>
                                </div>
                            `);
                        });
                    });
            }, 300);
        });
    </script>
}
