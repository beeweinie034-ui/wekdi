@model wekdi.Models.Order
@{
    ViewData["Title"] = "Delete Order";
    Layout = "AdminSidebar"; // or your admin layout
}

<h2>Delete Order</h2>
<p>Are you sure you want to delete this order?</p>

<dl class="row">
    <dt class="col-sm-2">Order #</dt>
    <dd class="col-sm-10">@Model.OrderId</dd>

    <dt class="col-sm-2">Member</dt>
    <dd class="col-sm-10">@Model.Member?.Username</dd>

    <dt class="col-sm-2">Order Date</dt>
    <dd class="col-sm-10">@Model.OrderDate.ToString("yyyy-MM-dd HH:mm")</dd>

    <dt class="col-sm-2">Total</dt>
    <dd class="col-sm-10">@Model.TotalAmount.ToString("C")</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="OrderId" />
    <button type="submit" class="btn btn-danger">Confirm Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
