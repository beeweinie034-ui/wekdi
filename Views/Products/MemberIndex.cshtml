@model IEnumerable<wekdi.Models.Product>

@{
    Layout = "Sidebar"; // Use the member sidebar
    ViewData["Title"] = "Products";
}

<h2 class="mb-4">Products</h2>

<div class="row g-4">
    @foreach (var product in Model)
    {
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <img src="@(string.IsNullOrEmpty(product.ImagePath)
                                 ? "https://via.placeholder.com/300x200"
                                 : Url.Content("~/images/products/" + product.ImagePath))"
                 class="card-img-top"
                 alt="@product.Name">

                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@product.Name</h5>
                    <p class="card-text">@product.Description</p>
                    <p class="card-text fw-bold">@product.Price.ToString("C")</p>
                    <div class="mt-auto">
                        <button class="btn btn-primary" @(product.Stock == 0 ? "disabled" : "")>
                            @(product.Stock == 0 ? "Out of Stock" : "Buy Now")
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
