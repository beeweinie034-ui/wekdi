@model wekdi.Models.Admin

@{
    ViewData["Title"] = "Admin Profile";
}

<style>
    /* ====== Admin Profile Page ====== */
    .admin-profile-container {
        max-width: 700px;
        margin: 40px auto;
        background: #ffffff;
        padding: 30px 40px;
        border-radius: 12px;
        box-shadow: 0 6px 20px rgba(0,0,0,0.12);
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
    }

        .admin-profile-container h2 {
            text-align: center;
            font-weight: 700;
            color: #d32f2f;
            margin-bottom: 30px;
        }

        /* ---- Definition list as 2-column grid ---- */
        .admin-profile-container dl {
            display: grid;
            grid-template-columns: 180px 1fr; /* fixed label width + flexible value */
            row-gap: 12px;
            column-gap: 16px;
            margin-bottom: 30px;
        }

        .admin-profile-container dt {
            font-weight: 600;
            color: #333;
            text-align: right; /* right-align labels for neatness */
        }

        .admin-profile-container dd {
            margin: 0; /* remove default dd margin */
            color: #555;
            padding-bottom: 0; /* no underline or extra spacing */
        }

    /* Button group */
    .admin-profile-actions {
        text-align: center;
        margin-top: 20px;
    }

        .admin-profile-actions .btn {
            min-width: 150px;
            margin: 0 8px 12px;
            font-weight: 600;
            border-radius: 8px;
            padding: 10px 20px;
        }

        .admin-profile-actions .btn-primary {
            background-color: #ffc107;
            border: none;
            color: #212529;
        }

            .admin-profile-actions .btn-primary:hover {
                background-color: #e0a800;
                color: #000;
            }

        .admin-profile-actions .btn-secondary {
            background-color: #6c757d;
            border: none;
        }

        .admin-profile-actions .btn-danger {
            background-color: #d32f2f;
            border: none;
        }
</style>

<div class="admin-profile-container">
    <h2>Your Admin Profile</h2>

    <dl>
        <dt>Username</dt>
        <dd>@Model.Username</dd>

        <dt>Email</dt>
        <dd>@Model.Email</dd>

        <dt>Role</dt>
        <dd>@Model.Role</dd>

        <dt>Active</dt>
        <dd>@(Model.IsActive ? "Yes" : "No")</dd>
    </dl>

    <div class="admin-profile-actions">
        <a asp-controller="Reports" asp-action="TopProducts" class="btn btn-secondary">Back</a>

        <form asp-action="Logout" asp-controller="Account" method="post" class="d-inline">
            <button type="submit" class="btn btn-danger">Logout</button>
        </form>
    </div>
</div>
