@{
    ViewData["Title"] = "Reset Password";
}

<style>
    /* 🔑 Centered card container */
    .reset-wrapper {
        max-width: 650px;
        width: 100%;
        margin: 3rem auto;
        padding: 3rem 3rem 2.5rem;
        background: #ffffff;
        border-radius: 1rem;
        box-shadow: 0 8px 25px rgba(0,0,0,0.15);
        text-align: center;
    }

        .reset-wrapper h2 {
            font-size: 2.4rem;
            font-weight: 700;
            color: #d32f2f;
            margin-bottom: 1.5rem;
        }

        .reset-wrapper form {
            text-align: left;
        }

        .reset-wrapper .form-label {
            font-weight: 600;
            color: #333;
        }

        .reset-wrapper .form-control {
            border-radius: 30px;
            padding: 0.9rem 1rem;
            font-size: 1.1rem;
        }

    .btn-primary {
        background-color: #d32f2f;
        border: none;
        font-weight: 600;
        border-radius: 30px;
        padding: 0.8rem 1.4rem;
        font-size: 1.1rem;
        transition: background .2s;
        width: 100%;
    }

        .btn-primary:hover {
            background-color: #b71c1c;
        }

    .btn-secondary {
        border-radius: 30px;
        font-weight: 600;
        padding: 0.7rem 1.4rem;
        width: 100%;
    }

    .progress {
        height: 10px;
        border-radius: 5px;
    }

    .alert {
        text-align: left;
    }
</style>

<div class="reset-wrapper">
    <h2>Reset Password</h2>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    @if (ViewBag.Message != null)
    {
        <div class="alert alert-success">@ViewBag.Message</div>
    }

    <form method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="email" value="@ViewBag.Email" />
        <input type="hidden" name="token" value="@ViewBag.Token" />

        <div class="mb-3 position-relative">
            <label class="form-label">New Password</label>
            <div class="input-group">
                <input type="password" id="Password" name="newPassword" class="form-control" required />
                <button type="button" class="btn btn-outline-secondary" onclick="togglePassword('Password', this)">Shown</button>
            </div>
            <small id="passwordRequirements" class="form-text text-danger">
                Password must be at least 6 characters and include at least one uppercase, one lowercase, one number, and one special character.
            </small>

            <div class="mt-2">
                <div class="progress">
                    <div id="passwordStrengthBar" class="progress-bar" role="progressbar" style="width: 0%;"></div>
                </div>
                <small id="passwordStrengthText" class="form-text"></small>
            </div>
        </div>

        <div class="mb-3 position-relative">
            <label class="form-label">Confirm Password</label>
            <div class="input-group">
                <input type="password" id="ConfirmPassword" name="confirmPassword" class="form-control" required />
                <button type="button" class="btn btn-outline-secondary" onclick="togglePassword('ConfirmPassword', this)">Shown</button>
            </div>
        </div>

        <button type="submit" class="btn btn-primary">Reset Password</button>
        <a asp-action="Login" class="btn btn-secondary mt-2">Back to Login</a>
    </form>
</div>

@section Scripts {
    <script>
        function togglePassword(inputId, btn) {
            const input = document.getElementById(inputId);
            if (input.type === "password") {
                input.type = "text";
                btn.textContent = "Hidden";
            } else {
                input.type = "password";
                btn.textContent = "Shown";
            }
        }

        const passwordInput = document.getElementById("Password");
        const reqText = document.getElementById("passwordRequirements");
        const strengthBar = document.getElementById("passwordStrengthBar");
        const strengthText = document.getElementById("passwordStrengthText");

        passwordInput.addEventListener("input", function () {
            const pwd = passwordInput.value;
            const regex = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[\W_]).{6,}$/;

            reqText.style.display = regex.test(pwd) ? "none" : "block";

            let score = 0;
            if (pwd.length >= 6) score++;
            if (/[A-Z]/.test(pwd)) score++;
            if (/[a-z]/.test(pwd)) score++;
            if (/\d/.test(pwd)) score++;
            if (/[\W_]/.test(pwd)) score++;

            const percent = (score / 5) * 100;
            strengthBar.style.width = percent + "%";

            if (score <= 2) {
                strengthBar.className = "progress-bar bg-danger";
                strengthText.textContent = "Weak";
                strengthText.style.color = "red";
            } else if (score === 3 || score === 4) {
                strengthBar.className = "progress-bar bg-warning";
                strengthText.textContent = "Medium";
                strengthText.style.color = "orange";
            } else {
                strengthBar.className = "progress-bar bg-success";
                strengthText.textContent = "Strong";
                strengthText.style.color = "green";
            }
        });
    </script>
}
