@{
    ViewData["Title"] = "Forgot Password";
}

<style>
    /* 🔑 Centered larger container */
    .forgot-wrapper {
        max-width: 600px; /* wider form card */
        width: 100%;
        margin: 3rem auto;
        padding: 3rem 3rem 2.5rem;
        background: #ffffff;
        border-radius: 1rem;
        box-shadow: 0 8px 25px rgba(0,0,0,0.15);
        text-align: center;
    }

        .forgot-wrapper h2 {
            font-size: 2.4rem;
            font-weight: 700;
            color: #d32f2f;
            margin-bottom: 1.5rem;
        }

        .forgot-wrapper form {
            text-align: left;
        }

        .forgot-wrapper .form-label {
            font-weight: 600;
            color: #333;
        }

        .forgot-wrapper .form-control {
            border-radius: 30px;
            padding: 0.9rem 1rem;
            font-size: 1.1rem;
        }

    /* Buttons */
    .btn-primary {
        background-color: #d32f2f;
        border: none;
        font-weight: 600;
        border-radius: 30px;
        padding: 0.8rem 1.4rem;
        font-size: 1.1rem;
        transition: background .2s;
        width: 100%;
    }

        .btn-primary:hover {
            background-color: #b71c1c;
        }

    .btn-secondary {
        border-radius: 30px;
        font-weight: 600;
        padding: 0.7rem 1.4rem;
        width: 100%;
    }

    .alert {
        text-align: left;
    }
</style>

<div class="forgot-wrapper">
    <h2>Forgot Password</h2>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    @if (ViewBag.Success != null)
    {
        <div class="alert alert-success">@ViewBag.Success</div>
    }

    <form asp-action="ForgotPassword" method="post">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label class="form-label">Email</label>
            <input type="email" name="email" class="form-control" required />
        </div>

        <button type="submit" class="btn btn-primary mt-3">Send Reset Link</button>
        <a asp-action="Login" class="btn btn-secondary mt-3">Back to Login</a>
    </form>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
