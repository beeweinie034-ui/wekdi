@model wekdi.Models.Member

@{
    ViewData["Title"] = "Member Profile";
}

<!-- === Embedded McDonald's Style CSS === -->
<style>
    body {
        background-color: #fff8f0;
        font-family: "Segoe UI", Arial, sans-serif;
    }

    h2 {
        color: #d32300; /* McDonald's red */
        font-weight: 700;
        margin-bottom: 1.5rem;
    }

    .btn-secondary {
        background-color: #d32300;
        border: none;
        color: #fff;
        font-weight: 600;
        padding: 0.5rem 1.2rem;
        border-radius: 30px;
        transition: background-color .2s;
    }

        .btn-secondary:hover {
            background-color: #b71c00;
        }

    /* Card-like container for profile */
    .profile-card {
        background: #fff;
        border-radius: 15px;
        padding: 2rem;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }

    .img-thumbnail {
        border: 3px solid #ffd100; /* golden yellow border */
        border-radius: 50%;
        padding: 4px;
        background: #fff;
        width: 200px;
        height: 200px;
        object-fit: cover;
    }

    dt {
        color: #d32300;
        font-weight: 600;
    }

    dd {
        color: #333;
        margin-bottom: 1rem;
    }

    .btn-primary {
        background-color: #ffd100;
        border: none;
        color: #000;
        font-weight: 600;
        padding: 0.5rem 1.2rem;
        border-radius: 25px;
        transition: background-color .2s;
    }

        .btn-primary:hover {
            background-color: #e6c400;
        }

    .btn-success {
        background-color: #28a745;
        border: none;
        font-weight: 600;
        padding: 0.5rem 1.2rem;
        border-radius: 25px;
        transition: background-color .2s;
    }

        .btn-success:hover {
            background-color: #218838;
        }

    .btn-danger {
        background-color: #d32300;
        border: none;
        font-weight: 600;
        padding: 0.5rem 1.2rem;
        border-radius: 25px;
        transition: background-color .2s;
    }

        .btn-danger:hover {
            background-color: #b71c00;
        }

    .mt-3 .btn {
        margin-right: 0.5rem;
    }
</style>

<a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Back to Homepage</a>
<br />
<br />

<h2>Your Profile</h2>

<div class="profile-card row">
    <div class="col-md-4 text-center mb-4 mb-md-0">
        <img src="@Url.Content(Model.ProfileImagePath ?? "/images/profiles/Default.png")"
             class="img-thumbnail mb-3"
             alt="Profile Picture" />
    </div>

    <div class="col-md-8">
        <dl class="row">
            <dt class="col-sm-4">Username</dt>
            <dd class="col-sm-8">@Model.Username</dd>

            <dt class="col-sm-4">Full Name</dt>
            <dd class="col-sm-8">@(!string.IsNullOrEmpty(Model.FullName) ? Model.FullName : "-")</dd>

            <dt class="col-sm-4">Email</dt>
            <dd class="col-sm-8">@(!string.IsNullOrEmpty(Model.Email) ? Model.Email : "-")</dd>

            <dt class="col-sm-4">Phone</dt>
            <dd class="col-sm-8">@(!string.IsNullOrEmpty(Model.Phone) ? Model.Phone : "-")</dd>

            <dt class="col-sm-4">Address</dt>
            <dd class="col-sm-8">@(!string.IsNullOrEmpty(Model.Address) ? Model.Address : "-")</dd>

            <dt class="col-sm-4">Joined On</dt>
            <dd class="col-sm-8">@Model.JoinDate.ToString("dd MMMM yyyy")</dd>

            <dt class="col-sm-4">Account Status</dt>
            <dd class="col-sm-8">@((Model.IsActive) ? "Active" : "Inactive")</dd>
        </dl>

        <div class="mt-3">
            <a asp-action="EditProfile" class="btn btn-primary">Edit Profile</a>
            <a asp-controller="MemberOrders" asp-action="OrderHistory" class="btn btn-success">Order History</a>
            <form asp-action="Logout" asp-controller="Account" method="post" class="d-inline">
                <button type="submit" class="btn btn-danger">Logout</button>
            </form>
        </div>
    </div>
</div>
